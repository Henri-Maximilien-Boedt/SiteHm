---
import { useTranslations, switchLangPath, type Lang } from '../../i18n/ui';
import WebGLWall from './WebGLWall.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const otherPath = switchLangPath(Astro.url, other);

// Mur (DOM pour l'instant → OGL ensuite). Fichiers dans /public/photos.
const wall = [
  { f: 'DSC_2693', cap: 'Séoul · DDP', tall: true },
  { f: 'DSC_6857', cap: 'Ukai · pêche au feu' },
  { f: 'DSC_7175', cap: 'Osaka · nuit' },
  { f: '_BDR9272', cap: 'Etna' },
  { f: 'DSC_6780', cap: "Feu sur l'eau" },
  { f: 'DSC_2904', cap: 'Séoul · DDP', tall: true },
  { f: '_BDR0798', cap: 'Spa · motorsport' },
  { f: 'DSC_6586', cap: 'Lac · crépuscule' },
  { f: 'DSC_2891', cap: 'Séoul · DDP' },
  { f: 'DSC_7158', cap: 'Osaka · heure bleue' },
  { f: '_BDR7703', cap: 'Pleine lune' },
  { f: 'DSC_2880', cap: 'Séoul · DDP', tall: true },
  { f: 'DSC_3825', cap: 'Busan · Petit Prince' },
  { f: 'DSC_5585', cap: 'Osaka · canal' },
  { f: '_BDR7734', cap: 'Alpes' },
  { f: '_BDR3467', cap: 'Pit lane' },
];
---

<main class="home">
  <div class="horizon" aria-hidden="true"></div>
  <div class="bar" id="hmBar" aria-hidden="true"></div>

  <!-- loader -->
  <div class="loader" id="hmLoader">
    <div class="loader__count" id="hmCount">0<span class="pct">%</span></div>
    <div class="loader__meta u-mono">
      Henri-Maximilien Boedt<br />Nocturne<br /><span class="em">{t('loader.sub')}</span>
    </div>
  </div>

  <!-- nav -->
  <header class="nav" id="hmNav">
    <a class="nav__brand" href={`/${lang}`}>HMB<span class="sep"> · </span>studio</a>
    <nav class="nav__right u-mono">
      <span class="nav__loc"><i class="dot"></i>{t('nav.location')}</span>
      <span class="nav__lang">
        <span class="on">{lang.toUpperCase()}</span> / <a href={otherPath} data-astro-reload>{other.toUpperCase()}</a>
      </span>
      <button id="hmSound" type="button">{t('sound.off')}</button>
    </nav>
  </header>

  <!-- stage -->
  <section class="stage" id="hmStage" aria-label="Galerie">
    <canvas class="gl" id="hmGL" aria-hidden="true" data-cursor={t('a11y.drag')}></canvas>
    <div class="wall" id="hmWall">
      {wall.map((p) => (
        <figure class={`tile${p.tall ? ' tile--tall' : ''}`} data-cursor={t('a11y.view')}>
          <img src={`/photos/${p.f}.jpg`} alt={p.cap} loading="lazy" decoding="async" draggable="false" />
          <figcaption class="tile__cap u-mono">{p.cap}</figcaption>
        </figure>
      ))}
    </div>
    <div class="scrim" aria-hidden="true"></div>

    <div class="hero">
      <p class="hero__ey u-mono" id="hmEy">{t('home.eyebrow')}</p>
      <h1 class="name" id="hmName">
        <span class="glow" aria-hidden="true"></span>
        <span class="row row--outline"><span>Henri-Maximilien</span></span>
        <span class="row row--solid"><span>Boedt</span></span>
      </h1>
      <div class="uline" id="hmUline" aria-hidden="true"></div>
      <p class="tag" id="hmTag" set:html={`${t('home.tagline_a')} <b>${t('home.tagline_b')}</b>${t('home.tagline_c')}`}></p>
    </div>

    <nav class="doors" id="hmDoors" aria-label="Entrées">
      <a class="door" href={`/${lang}/photographie`} data-cursor={t('a11y.enter')} data-astro-reload>
        <span class="door__k u-mono">{t('home.door.photo.k')}</span>
        <h2 class="door__h">{t('home.door.photo.h')}</h2>
        <span class="door__arrow" aria-hidden="true">→</span>
        <span class="door__fill" aria-hidden="true"></span>
        <span class="door__peek" aria-hidden="true"><img src="/photos/DSC_6857.jpg" alt="" /></span>
      </a>
      <a class="door" href={`/${lang}/travail`} data-cursor={t('a11y.enter')} data-astro-reload>
        <span class="door__k u-mono">{t('home.door.work.k')}</span>
        <h2 class="door__h">{t('home.door.work.h')}</h2>
        <span class="door__arrow" aria-hidden="true">→</span>
        <span class="door__fill" aria-hidden="true"></span>
        <span class="door__peek" aria-hidden="true"><img src="/photos/_BDR0798.jpg" alt="" /></span>
      </a>
    </nav>
  </section>

  <WebGLWall />
</main>

<style>
  .home { position: relative; width: 100vw; height: 100dvh; overflow: hidden; }

  .horizon {
    position: fixed; left: 50%; bottom: -28vh; transform: translateX(-50%);
    width: 120vw; height: 56vh; z-index: 1; pointer-events: none;
    background: radial-gradient(60% 100% at 50% 100%, rgba(232,84,27,.26), rgba(232,84,27,.07) 42%, transparent 70%);
    animation: breathe 7s ease-in-out infinite;
  }
  @keyframes breathe { 0%,100%{opacity:.75} 50%{opacity:1} }

  .loader {
    position: fixed; inset: 0; z-index: var(--z-loader); background: var(--bg);
    display: flex; align-items: flex-end; justify-content: space-between; padding: 7vh 6vw;
    transition: transform var(--dur-3) var(--ease-inout);
  }
  .loader.is-done { transform: translateY(-101%); }
  .loader__count { font-family: var(--font-display); font-weight: 500; font-size: clamp(5rem,26vw,22rem); line-height: .78; letter-spacing: -.04em; }
  .loader__count .pct { font-family: var(--font-mono); font-size: .13em; color: var(--ember); vertical-align: super; margin-left: .2em; }
  .loader__meta { font-size: var(--step--1); color: var(--muted); text-align: right; line-height: 2; }
  .loader__meta .em { color: var(--ember); }
  .bar { position: fixed; left: 0; bottom: 0; height: 2px; background: var(--ember); width: 0; z-index: calc(var(--z-loader) + 1); box-shadow: 0 0 22px var(--ember); transition: opacity .6s; }

  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: var(--z-nav);
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.7rem 2.4rem; font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: .16em; text-transform: uppercase; opacity: 0; transition: opacity var(--dur-3) ease .4s;
  }
  .home.is-live .nav { opacity: 1; }
  .nav__brand { font-weight: 700; text-decoration: none; }
  .nav__brand .sep { color: var(--muted); }
  .nav__right { display: flex; gap: 1.8rem; align-items: center; color: var(--muted); }
  .nav__lang .on { color: var(--ink); }
  .nav__lang a { text-decoration: none; }
  .nav .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ember); display: inline-block; margin-right: .55rem; box-shadow: 0 0 8px var(--ember); }
  .nav button { background: none; border: none; color: inherit; font: inherit; letter-spacing: inherit; cursor: pointer; text-transform: uppercase; }

  .stage { position: relative; width: 100vw; height: 100dvh; overflow: hidden; z-index: var(--z-wall); }
  .gl { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 3; display: none; touch-action: none; }
  .stage.is-gl .gl { display: block; }
  .stage.is-gl .wall { display: none; }
  .wall {
    position: absolute; top: 50%; left: 50%;
    display: grid; grid-template-columns: repeat(4, 32vw); grid-auto-rows: 25vw; gap: 1.5vw;
    transform: translate(-50%, -50%); will-change: transform, filter; cursor: grab;
    filter: brightness(.3) contrast(1.05) grayscale(.5); transition: filter 1.1s ease;
  }
  .wall.is-waking { filter: brightness(.52) contrast(1.05) grayscale(.2); }
  .wall.is-drag { cursor: grabbing; }
  .tile { position: relative; overflow: hidden; background: var(--bg-2); margin: 0; }
  .tile--tall { grid-row: span 2; }
  .tile img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.03); transition: transform .9s var(--ease-out), filter .9s; }
  .tile::before {
    content: ""; position: absolute; inset: 0; z-index: 2; opacity: 0; transition: opacity .6s;
    background: radial-gradient(120% 120% at 50% 120%, rgba(232,84,27,.42), transparent 60%); mix-blend-mode: overlay;
  }
  .tile:hover img { transform: scale(1.14) skewX(-1.2deg); filter: saturate(1.35) brightness(1.55); }
  .tile:hover::before { opacity: 1; }
  .tile__cap { position: absolute; left: .8rem; bottom: .7rem; z-index: 3; font-size: .6rem; color: var(--ink); opacity: 0; transition: opacity .4s; text-shadow: 0 1px 10px #000; }
  .tile:hover .tile__cap { opacity: .9; }

  .scrim {
    position: absolute; inset: 0; pointer-events: none; z-index: 10;
    background:
      radial-gradient(52% 50% at 50% 46%, rgba(9,9,10,.92) 0%, rgba(9,9,10,.6) 40%, rgba(9,9,10,0) 72%),
      radial-gradient(130% 120% at 50% 50%, rgba(9,9,10,0) 48%, rgba(9,9,10,.92) 100%);
  }

  .hero { position: absolute; inset: 0; z-index: var(--z-hero); display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; text-align: center; }
  .hero__ey { font-size: .74rem; letter-spacing: .44em; color: var(--ember); margin-bottom: 1.8rem; opacity: 0; transition: opacity var(--dur-3) ease .9s; }
  .home.is-live .hero__ey, .home.is-live .tag { opacity: 1; }
  .name { font-family: var(--font-display); font-weight: 600; line-height: .82; letter-spacing: -.045em; font-size: var(--step-hero); text-transform: uppercase; position: relative; }
  .row { display: block; overflow: hidden; padding: 0 .04em; }
  .row > span { display: inline-block; transform: translateY(112%); transition: transform var(--dur-3) var(--ease-out); }
  .row--outline > span { color: transparent; -webkit-text-stroke: 1.3px rgba(243,239,232,.5); }
  .row--solid > span { transition-delay: .08s; }
  .name.is-rev .row > span { transform: translateY(0); }
  .glow { position: absolute; inset: -18% -8%; z-index: -1; background: radial-gradient(50% 50% at 50% 50%, rgba(232,84,27,.2), transparent 70%); opacity: .4; animation: nameglow 6s ease-in-out infinite 2s; }
  @keyframes nameglow { 0%,100%{opacity:.35} 50%{opacity:.7} }
  .uline { width: 0; height: 2px; background: var(--ember); margin: 2rem auto 0; box-shadow: 0 0 16px var(--ember); transition: width 1.1s var(--ease-out) .5s; }
  .uline.is-rev { width: min(38vw, 460px); }
  .tag { margin-top: 1.8rem; font-size: clamp(.82rem,1.1vw,1.02rem); color: var(--ink-dim); opacity: 0; transition: opacity var(--dur-3) ease 1.1s; }
  .tag :global(b) { color: var(--ink); font-weight: 500; }

  .doors { position: absolute; left: 0; right: 0; bottom: 0; z-index: 30; display: grid; grid-template-columns: 1fr 1fr; opacity: 0; transform: translateY(16px); transition: opacity var(--dur-3) ease 1.2s, transform var(--dur-3) ease 1.2s; }
  .home.is-live .doors { opacity: 1; transform: none; }
  .door { position: relative; padding: 2.2rem 3vw 2.4rem; display: flex; align-items: flex-end; justify-content: space-between; text-decoration: none; color: var(--ink); overflow: hidden; border-top: 1px solid var(--line); }
  .door + .door { border-left: 1px solid var(--line); }
  .door__k { font-size: .64rem; letter-spacing: .2em; color: var(--muted); position: absolute; top: 1.5rem; left: 3vw; }
  .door__h { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.7rem,4.6vw,4.2rem); letter-spacing: -.02em; line-height: 1; transition: transform .5s var(--ease-out); }
  .door__arrow { font-family: var(--font-display); font-size: clamp(1.4rem,3vw,2.6rem); color: var(--ember); opacity: 0; transform: translateX(-14px); transition: .5s; }
  .door__peek { position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity .7s; }
  .door__peek img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.35) brightness(.42) contrast(1.1); }
  .door:hover .door__h { transform: translateY(-6px); }
  .door:hover .door__arrow { opacity: 1; transform: translateX(0); }
  .door:hover .door__peek { opacity: .55; }
  .door__fill { position: absolute; left: 0; top: 0; height: 2px; width: 0; background: var(--ember); transition: width .6s var(--ease-out); box-shadow: 0 0 14px var(--ember); }
  .door:hover .door__fill { width: 100%; }

  @media (max-width: 720px) {
    .wall { grid-template-columns: repeat(2, 52vw); grid-auto-rows: 40vw; }
    .doors { grid-template-columns: 1fr; }
    .door + .door { border-left: none; }
    .nav__loc { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .row > span { transform: none !important; }
    .uline { width: min(38vw, 460px) !important; }
    .horizon { animation: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const home = document.querySelector('.home') as HTMLElement;
  const loader = document.getElementById('hmLoader')!;
  const count = document.getElementById('hmCount')!;
  const bar = document.getElementById('hmBar')!;
  const name = document.getElementById('hmName')!;
  const uline = document.getElementById('hmUline')!;
  const wall = document.getElementById('hmWall') as HTMLElement;

  function reveal() {
    loader.classList.add('is-done');
    home.classList.add('is-live');
    name.classList.add('is-rev');
    uline.classList.add('is-rev');
    bar.style.opacity = '0';
  }

  if (reduce) {
    reveal();
  } else {
    let p = 0;
    const tick = () => {
      p += Math.max(1, (100 - p) * 0.055);
      if (p >= 100) p = 100;
      (count.firstChild as Text).textContent = String(Math.floor(p));
      (bar as HTMLElement).style.width = p + '%';
      if (p < 100) requestAnimationFrame(tick);
      else setTimeout(reveal, 480);
    };
    requestAnimationFrame(tick);
  }

  // mur draggable + éveil
  let ox = 0, oy = 0, down = false, sx = 0, sy = 0, bx = 0, by = 0;
  let wake: ReturnType<typeof setTimeout>;
  const clamp = () => {
    const m = 240, w = wall.getBoundingClientRect();
    const mx = Math.max(0, (w.width - innerWidth) / 2 + m);
    const my = Math.max(0, (w.height - innerHeight) / 2 + m);
    ox = Math.max(-mx, Math.min(mx, ox));
    oy = Math.max(-my, Math.min(my, oy));
  };
  const apply = () => { wall.style.transform = `translate(-50%,-50%) translate(${ox}px,${oy}px)`; };
  const keepAwake = () => { wall.classList.add('is-waking'); clearTimeout(wake); wake = setTimeout(() => wall.classList.remove('is-waking'), 1400); };

  wall.addEventListener('pointerdown', (e) => { down = true; wall.classList.add('is-drag'); sx = e.clientX; sy = e.clientY; bx = ox; by = oy; });
  addEventListener('pointerup', () => { down = false; wall.classList.remove('is-drag'); });
  addEventListener('pointermove', (e) => { if (!down) return; ox = bx + (e.clientX - sx); oy = by + (e.clientY - sy); clamp(); apply(); keepAwake(); });
  wall.addEventListener('pointerenter', keepAwake);

  // parallaxe lente + nom cinétique
  let tx = innerWidth / 2, ty = innerHeight / 2;
  if (!reduce) {
    addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; }, { passive: true });
    const sp = Array.from(name.querySelectorAll<HTMLElement>('.row > span'));
    (function par() {
      const nx = tx / innerWidth - 0.5, ny = ty / innerHeight - 0.5;
      if (!down) { ox += (-nx * 54 - ox) * 0.012; oy += (-ny * 34 - oy) * 0.012; clamp(); apply(); }
      sp.forEach((l, i) => { const d = 1 + i * 0.7; l.style.transform = `translate(${nx * 24 * d}px, ${ny * 12 * d}px) skewX(${nx * 1.6}deg)`; });
      requestAnimationFrame(par);
    })();
  }

  // toggle son (visuel pour l'instant)
  const sbtn = document.getElementById('hmSound') as HTMLButtonElement;
  let son = false;
  sbtn?.addEventListener('click', () => {
    son = !son;
    sbtn.textContent = son ? 'Son ● on' : 'Son ◦ off';
    sbtn.style.color = son ? 'var(--ember)' : '';
  });
</script>
